# ---------------------------------------------------------------------------
# TCG Vault — configuration. Toutes les variables sont facultatives :
# sans Supabase, le site fonctionne en « mode direct » (API publiques + cache).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://votre-domaine.fr

# --- Supabase (base PostgreSQL, authentification, synchronisation) ---------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # serveur uniquement : synchronisations et admin
CRON_SECRET=                        # protège /api/cron/sync (Vercel Cron l'envoie automatiquement)
# DATA_MODE=live                    # force la lecture directe des API même avec Supabase

# --- Catalogues (sans clé) ---------------------------------------------------
POKEMON_CATALOG_LANG=fr             # langue TCGdex (fr, en, de, it, es, pt) avec repli sur en
# TCGDEX_BASE_URL=https://api.tcgdex.net/v2
# OPTCG_BASE_URL=https://optcgapi.com/api

# --- Sources de prix complémentaires (clé / autorisation requise) ----------
JUSTTCG_API_KEY=                    # https://justtcg.com — Pokémon + One Piece, variations, historique
POKEMONTCG_API_KEY=                 # https://dev.pokemontcg.io (facultatif)
POKEMONTCG_ENABLED=false
CARDMARKET_APP_TOKEN=               # API MKM 2.0 — compte professionnel approuvé par Cardmarket
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_TOKEN_SECRET=
TCGPLAYER_PUBLIC_KEY=               # clés partenaires TCGplayer
TCGPLAYER_PRIVATE_KEY=
EBAY_CLIENT_ID=                     # eBay Marketplace Insights (accès restreint, sur demande)
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_FR

# Sources externes interrogées pour les cartes valant au moins X € (économise les quotas)
EXTERNAL_MIN_PRICE_EUR=5
EXTERNAL_BATCH_SIZE=25

# --- Actualités (flux RSS : url|nom|jeu, séparés par des virgules) ----------
# NEWS_FEEDS=https://www.pokebeach.com/feed|PokéBeach|pokemon
